{
  "name": "choubei-planner",
  "version": "1.0.0",
  "description": "商业地产项目筹备计划生成系统",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vue-tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "db:init": "tsx src/server/database/init.ts"
  },
  "dependencies": {
    "@vueuse/core": "^11.0.3",
    "better-sqlite3": "^11.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "lucide-vue-next": "^0.441.0",
    "multer": "^1.4.5-lts.1",
    "pinia": "^2.2.2",
    "radix-vue": "^1.9.6",
    "tailwind-merge": "^2.5.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.2",
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.3",
    "vue-tsc": "^2.1.4"
  }
}
